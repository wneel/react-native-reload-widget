{
	"name": "react-native-reload-widget",
	"version": "1.0.0",
	"description": "react-native-reload-widget is a lightweight and efficient React Native module that reloads your app's home screen widgets on demand, on iOS and Android.",
	"source": "./src/index.tsx",
	"main": "./lib/commonjs/index.js",
	"module": "./lib/module/index.js",
	"types": "./lib/typescript/commonjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./lib/typescript/module/index.d.ts",
				"default": "./lib/module/index.js"
			},
			"require": {
				"types": "./lib/typescript/commonjs/index.d.ts",
				"default": "./lib/commonjs/index.js"
			}
		}
	},
	"files": [
		"src",
		"lib",
		"android",
		"ios",
		"*.podspec",
		"react-native.config.js",
		"CHANGELOG.md",
		"!**/.*"
	],
	"scripts": {
		"clean": "del-cli lib android/build android/generated ios/generated",
		"build:cjs": "babel src --out-dir lib/commonjs --extensions \".js,.jsx,.ts,.tsx\" && npm run build:cjstypes",
		"build:esm": "babel src --out-dir lib/module --extensions \".js,.jsx,.ts,.tsx\" --env-name esm && npm run build:esmtypes",
		"build:babel": "npm run build:cjs && npm run build:esm",
		"build:cjstypes": "tsc -p tsconfig.commonjs.json",
		"build:esmtypes": "tsc -p tsconfig.module.json",
		"codegen": "npx @react-native-community/cli codegen --source library && node utils/patchCodegen.mjs",
		"build": "npm run build:babel && npm run codegen",
		"preprepare": "npm run clean",
		"prepare": "npm run build"
	},
	"keywords": [
		"react-native-module",
		"native-module",
		"turbo-module",
		"react-native",
		"typescript",
		"widget",
		"widgets",
		"widgetkit",
		"ios-widget",
		"android-widget",
		"appwidget",
		"app-extension",
		"reload",
		"refresh"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wneel/react-native-reload-widget.git"
	},
	"author": "Wayan NEEL <66263633+wneel@users.noreply.github.com> (https://github.com/wneel)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/wneel/react-native-reload-widget/issues"
	},
	"homepage": "https://github.com/wneel/react-native-reload-widget#readme",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@babel/cli": "^7.26.4",
		"@babel/core": "^7.26.0",
		"@babel/plugin-transform-typescript": "^7.26.3",
		"@babel/preset-env": "^7.26.0",
		"@babel/preset-typescript": "^7.26.0",
		"@react-native-community/cli": "^20.1.3",
		"@types/react": "^19.2.0",
		"del-cli": "^5.1.0",
		"fs-extra": "^11.2.0",
		"react": "19.2.8",
		"react-native": "0.87.1",
		"typescript": "^5.6.3"
	},
	"peerDependencies": {
		"react-native": ">=0.76"
	},
	"codegenConfig": {
		"name": "RNReloadWidgetSpec",
		"type": "modules",
		"jsSrcsDir": "src",
		"outputDir": {
			"ios": "ios/generated",
			"android": "android/generated"
		},
		"android": {
			"javaPackageName": "com.reloadwidget"
		},
		"includesGeneratedCode": true
	}
}
